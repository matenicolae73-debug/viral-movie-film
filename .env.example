# Server-side fal.ai API key. Add the real value only in Vercel Environment Variables.
FAL_KEY=
# Optional: override the default fal.ai model.
FAL_VIDEO_MODEL=fal-ai/vidu/q3/text-to-video/turbo
# Owner-only publishing secret. Keep server-side; never expose it in NEXT_PUBLIC_ variables.
OWNER_PUBLISH_TOKEN=
# Upstash REST storage (required for persistent Movies catalog)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob token for owner movie uploads. Add only in Vercel Environment Variables.
BLOB_READ_WRITE_TOKEN=
